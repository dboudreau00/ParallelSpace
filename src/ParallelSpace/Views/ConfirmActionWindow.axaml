<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ParallelSpace.Views.ConfirmActionWindow"
        Width="430" SizeToContent="Height" MinHeight="170"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Icon="/Assets/appicon.ico"
        Title="Confirm action">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="18">
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="subtle" Content="Cancel" IsCancel="True"
                    Click="OnCancel" />
            <Button Classes="primary" Content="Accept" Click="OnAccept" />
        </StackPanel>
    </StackPanel>
</Window>

